import torch
import torch.nn as nn
import torch.nn.functional as F

class CNNRNNHybridIEGMNet(nn.Module):
    def __init__(self, num_classes=2, hidden_size=64):
        super(CNNRNNHybridIEGMNet, self).__init__()
        self.conv1 = nn.Sequential(
            nn.Conv2d(in_channels=1, out_channels=3, kernel_size=(6, 1), stride=(2,1), padding=0),
            nn.ReLU(True),
            nn.BatchNorm2d(3, affine=True, track_running_stats=True, eps=1e-5, momentum=0.1),
        )
        self.conv2 = nn.Sequential(
            nn.Conv2d(in_channels=3, out_channels=5, kernel_size=(5, 1), stride=(2,1), padding=0),
            nn.ReLU(True),
            nn.BatchNorm2d(5, affine=True, track_running_stats=True, eps=1e-5, momentum=0.1),
        )
        self.conv3 = nn.Sequential(
            nn.Conv2d(in_channels=5, out_channels=10, kernel_size=(4, 1), stride=(2,1), padding=0),
            nn.ReLU(True),
            nn.BatchNorm2d(10, affine=True, track_running_stats=True, eps=1e-5, momentum=0.1),
        )
        
        # Assuming the output of conv3 has a time dimension of 37 (based on adaptive_pool in original model)
        self.rnn = nn.GRU(input_size=10, hidden_size=hidden_size, num_layers=2, batch_first=True)
        
        self.fc = nn.Linear(hidden_size, num_classes)

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.conv3(x)
        
        # Reshape for RNN input (batch, time_steps, features)
        x = x.squeeze(3).permute(0, 2, 1)
        
        # RNN layer
        x, _ = self.rnn(x)
        
        # Use the last output of the RNN
        x = x[:, -1, :]
        
        # Final classification layer
        x = self.fc(x)
        return x